{
  "name": "bulletsndguns",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "BulletsNdGuns: multiplayer platformer (Phaser + Socket.io), TypeScript monorepo.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "echo \"dev: not configured yet\"",
    "build": "echo \"build: not configured yet\"",
    "start": "echo \"start: not configured yet\"",
    "test": "vitest run",
    "lint": "eslint \"packages/*/{src,test}/**/*.ts\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgimitola/BulletsNdGuns.git"
  },
  "author": "JSJ",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
